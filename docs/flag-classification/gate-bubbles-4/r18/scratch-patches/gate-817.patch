+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import { readPositionAnswer } from "./employee-position";
+import { listFormDates } from "./form-date-answer";
+import {
+  draftDateApplies,
+  fidelityAwareTitle,
+  fidelityFormDate,
+  fidelityGivenDates,
+} from "./form-input-fidelity";
+
+const TODAY = "2026-10-24";
+const FLAG = "FORM_INPUT_FIDELITY_ENABLED";
+const saved = new Map<string, string | undefined>();
+
+function setFlag(on: boolean) {
+  if (!saved.has(FLAG)) saved.set(FLAG, process.env[FLAG]);
+  if (on) process.env[FLAG] = "1";
+  else delete process.env[FLAG];
+}
+
+afterEach(() => {
+  vi.unstubAllEnvs();
+  const value = saved.get(FLAG);
+  if (value === undefined) delete process.env[FLAG];
+  else process.env[FLAG] = value;
+});
+
+const POSITION = {
+  role: "assistant",
+  content:
+    "Is this new corrective action a **Verbal Warning** or a **Written Warning**?\n\nWhat is **Pat Rivera**'s position (job title)?",
+};
+
+describe("form input fidelity, flag off", () => {
+  it("leaves yesterday unset and still reads a bare warning as a job title", () => {
+    setFlag(false);
+    // This flag's off path alone: POSITION_ANSWER_GUARD (on in production) also stops "verbal" being a title, so it is
+    // pinned off here (QA's off-pins guard, 12 Nov 2026).
+    vi.stubEnv("POSITION_ANSWER_GUARD_ENABLED", "");
+    expect(fidelityFormDate("She was late yesterday.", TODAY, null)).toBeNull();
+    expect(fidelityFormDate("She was late on Oct 20.", TODAY, "2026-10-20")).toBe("2026-10-20");
+    expect(
+      fidelityAwareTitle("verbal", [
+        POSITION,
+        { role: "user", content: "verbal" },
+      ]),
+    ).toBe("Verbal");
+    expect(draftDateApplies("coaching")).toBe(false);
+    expect(draftDateApplies("corrective")).toBe(true);
+    expect(fidelityGivenDates("She was late yesterday.", TODAY)).toEqual(
+      listFormDates("She was late yesterday.", TODAY).map((found) => found.iso),
+    );
+  });
+});
+
+describe("form input fidelity, flag on", () => {
+  it("keeps Oct 20, 10/20, and yesterday, and leaves a missing date unset", () => {
+    setFlag(true);
+    expect(fidelityFormDate("She was late on Oct 20.", TODAY, null)).toBe("2026-10-20");
+    expect(fidelityFormDate("She was late on 10/20.", TODAY, null)).toBe("2026-10-20");
+    expect(fidelityFormDate("Date of Occurrence: Oct 20. She was late.", TODAY, null)).toBe("2026-10-20");
+    expect(fidelityFormDate("She was late yesterday.", TODAY, null)).toBe("2026-10-23");
+    expect(
+      fidelityFormDate("create a corrective action for Pat Rivera. She was late yesterday.", TODAY, null),
+    ).toBe("2026-10-23");
+    expect(fidelityFormDate("Previous warning yesterday.", TODAY, null)).toBeNull();
+    expect(fidelityFormDate("Date of Occurrence yesterday. She was late.", TODAY, null)).toBe("2026-10-23");
+    expect(fidelityFormDate("She was late.", TODAY, null)).toBeNull();
+    expect(fidelityFormDate("She was late on Oct 20 and again on 10/22.", TODAY, null)).toBeNull();
+    expect(fidelityFormDate("She was late yesterday.", TODAY, "2026-10-20")).toBe("2026-10-20");
+  });
+
+  it("does not save verbal, written, yes, or yesterday as the job title", () => {
+    setFlag(true);
+    const title = (reply: string) =>
+      fidelityAwareTitle(reply, [POSITION, { role: "user", content: reply }]);
+    expect(title("verbal")).toBeNull();
+    expect(title("written")).toBeNull();
+    expect(title("yes")).toBeNull();
+    expect(title("yesterday")).toBeNull();
+    expect(title("Oct 20")).toBeNull();
+    expect(title("10/20")).toBeNull();
+    expect(title("operator")).toBe("Operator");
+  });
+
+  it("tells a coaching draft the form date, and counts yesterday as a date the manager gave", () => {
+    setFlag(true);
+    // QA's #760 gate: Coaching is dated only alongside UNREAD_DAY_NOT_INCIDENT_DATE.
+    vi.stubEnv("UNREAD_DAY_NOT_INCIDENT_DATE_ENABLED", "");
+    expect(draftDateApplies("coaching")).toBe(false);
+    expect(draftDateApplies("corrective")).toBe(true);
+    vi.stubEnv("UNREAD_DAY_NOT_INCIDENT_DATE_ENABLED", "true");
+    expect(draftDateApplies("coaching")).toBe(true);
+    expect(draftDateApplies("corrective")).toBe(true);
+    expect(draftDateApplies("epp")).toBe(false);
+    expect(fidelityGivenDates("She was late yesterday.", TODAY)).toEqual(["2026-10-23"]);
+    expect(fidelityGivenDates("She was late on Oct 20.", TODAY)).toEqual(["2026-10-20"]);
+  });
+
+  /*
+   * Rebuilt on main (11 Nov 2026): the card's live title readers (`positionAnsweredIn`, `job-title-from-words.ts`)
+   * read the position answer through `readPositionAnswer`, so the bare-date rule sits there. The PR's reporter words.
+   */
+  it("a bare day answers the date, never the position question; a real title still does", () => {
+    setFlag(false);
+    expect(readPositionAnswer("yesterday")).toBe("Yesterday");
+    setFlag(true);
+    expect(readPositionAnswer("yesterday")).toBeNull();
+    expect(readPositionAnswer("Oct 20")).toBeNull();
+    expect(readPositionAnswer("10/20")).toBeNull();
+    expect(readPositionAnswer("on 10/20.")).toBeNull();
+    expect(readPositionAnswer("operator")).toBe("Operator");
+    expect(readPositionAnswer("shift lead")).toBe("Shift Lead");
+  });
+});
diff --git a/src/lib/forms/form-input-fidelity.ts b/src/lib/forms/form-input-fidelity.ts
new file mode 100644
index 00000000..1079bc8a
--- /dev/null
+++ b/src/lib/forms/form-input-fidelity.ts
@@ -0,0 +1,103 @@
+import { formInputFidelityEnabled, unreadDayNotIncidentDateEnabled } from "@/lib/config/chat-quality-flags";
+
+import { datesInText, listFormDates } from "./form-date-answer";
+import { incidentDates } from "./incident-dates";
+import { askedForPosition, positionAnsweredIn, readPositionAnswer } from "./employee-position";
+import { statedJobTitle } from "./proposal";
+import { spokenDates } from "./relative-date";
+import { statedWarningLevel } from "./warning-level";
+
+/**
+ * A typed incident date, and a one-word follow-up, kept as the manager said them.
+ *
+ * Off, both helpers return the same value the callers already used:
+ * `statedJobTitle ?? positionAnsweredIn`, and the form date already on the card.
+ * "yesterday" is not a calendar date (`form-date-answer.ts`), so the draft is
+ * dated today (`instances.ts`). A reply of "verbal" is also a short title
+ * (`employee-position.ts`) when the position question shares the assistant's
+ * last message with the warning question (`form-proposal.ts`).
+ */
+
+const PRIOR_STEP_NEAR =
+  /\b(?:previous(?:ly)?|prior|already|coached|coaching|warned|warning|write[- ]?ups?|corrective action)\b/i;
+
+const YES_NO = /^(?:yes|no|yeah|yep|nope|ok|okay)[\s.!]*$/i;
+
+type Turn = { readonly role: string; readonly content: string };
+
+/** The job title for the card. A bare warning, date, or yes/no is not one when the flag is on. */
+export function fidelityAwareTitle(text: string, conversation: readonly Turn[]): string | null {
+  const stated = statedJobTitle(text) ?? positionAnsweredIn(conversation);
+  if (!formInputFidelityEnabled()) return stated;
+  const company = statedJobTitle(text);
+  if (company) return company;
+  let answer: string | null = null;
+  for (let index = 1; index < conversation.length; index += 1) {
+    const turn = conversation[index]!;
+    const before = conversation[index - 1]!;
+    if (turn.role !== "user" || before.role !== "assistant" || !askedForPosition(before.content)) continue;
+    if (bareReplyIsNotATitle(turn.content)) continue;
+    const read = readPositionAnswer(turn.content);
+    if (read) answer = read;
+  }
+  return answer;
+}
+
+/**
+ * The form date when the card does not have one yet.
+ *
+ * One incident day the manager typed — "Oct 20", "10/20", "yesterday" — is
+ * that day. Several incident days stay unset, so the existing "which date?"
+ * question still dates the form today until they choose. No date at all stays
+ * unset, and the draft defaults to today.
+ */
+export function fidelityFormDate(text: string, today: string, current: string | null | undefined): string | null {
+  if (!formInputFidelityEnabled()) return current ?? null;
+  if (current) return current;
+  const incidents = incidentDates(text, today);
+  if (incidents.length === 1) return incidents[0]!;
+  if (incidents.length > 1) return null;
+  const relative = relativeIncidentDates(text, today);
+  return relative.length === 1 ? relative[0]! : null;
+}
+
+/** Calendar dates, plus a relative day when the flag is on. Off, the calendar list alone. */
+export function fidelityGivenDates(notes: string, today: string, base?: readonly string[]): string[] {
+  const calendar = base ? [...base] : listFormDates(notes, today).map((found) => found.iso);
+  if (!formInputFidelityEnabled()) return calendar;
+  return [...new Set([...calendar, ...relativeIncidentDates(notes, today)])];
+}
+
+/**
+ * Corrective drafts always. Coaching drafts only with the flag on AND UNREAD_DAY_NOT_INCIDENT_DATE_ENABLED (QA's #760
+ * gate, 12 Nov 2026): without it a day the reader could not date ("late last week") would be written as today's incident
+ * ("On October 26, 2026, <name> was late"). Safe by construction, not only because production has both on.
+ */
+export function draftDateApplies(layoutFamily: string): boolean {
+  if (layoutFamily === "corrective") return true;
+  return formInputFidelityEnabled() && unreadDayNotIncidentDateEnabled() && layoutFamily === "coaching";
+}
+
+function bareReplyIsNotATitle(reply: string): boolean {
+  const text = reply.trim();
+  if (text === "") return false;
+  if (YES_NO.test(text)) return true;
+  if (statedWarningLevel(text)) return true;
+  if (datesInText(text, "2026-06-15").length > 0) return true;
+  return relativeIncidentDates(text, "2026-06-15").length > 0;
+}
+
+function relativeIncidentDates(text: string, today: string): string[] {
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(today)) return [];
+  const calendar = datesInText(text, today);
+  const found: string[] = [];
+  for (const token of spokenDates(text, today)) {
+    if (!token.iso) continue;
+    if (calendar.some((item) => token.index < item.end && token.end > item.index)) continue;
+    const before = text.slice(Math.max(0, token.index - 80), token.index);
+    const sameClause = before.split(/[.;\n]/).pop() ?? before;
+    if (PRIOR_STEP_NEAR.test(sameClause)) continue;
+    found.push(token.iso);
+  }
+  return [...new Set(found)];
+}
