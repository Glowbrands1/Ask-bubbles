+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import { carriedPolicyTopic, isGoAheadTurn } from "./policy-carry-retrieval";
+
+/**
+ * POLICY_CARRY_RETRIEVAL_ENABLED (QA item 10; production, 25 Oct 2026, conv_mvofuq3l2jae1be; #180 rebuilt on main, 12 Nov
+ * 2026). The manager's turns, names invented: T2 "cite animals in the workplace policy" was answered from
+ * Animals in the Workplace p.30; T4 "just make it" was searched on its own words and the reply denied the policy. The
+ * search itself (`ai/server-ask.ts`, Coding-2's file) reads `carriedPolicyTopic`; these are the reader's own cases.
+ */
+const T1 =
+  "do verbl for Wren Okafor at Larkfield. no payrol deduct. prev coachng jba manual 11-1-25. on 10-22-26 Wren wasnt scheduled and came in to show her puppy 45 min";
+const T2 = "cite animals in the workplace policy";
+const T3 = "I already told you the store is Larkfield";
+const HISTORY = [
+  { role: "user", content: T1 },
+  { role: "assistant", content: "Which store is this actually for? I won't guess." },
+  { role: "user", content: T2 },
+  { role: "assistant", content: "Animals in the Workplace: The Company doesn't allow pets in the workplace [p.30]." },
+  { role: "user", content: T3 },
+  { role: "assistant", content: "Got it. Say \"create a coaching form for Wren Okafor\" and I'll bring up the draft." },
+];
+
+afterEach(() => vi.unstubAllEnvs());
+
+describe("T4 \"just make it\"", () => {
+  it("off: no carried topic (searched as before)", () => {
+    // R819 (QA, 12 Nov 2026): the off arm stubs its own flag, so a shell or gate with the flag on cannot change it.
+    vi.stubEnv("POLICY_CARRY_RETRIEVAL_ENABLED", "");
+    expect(carriedPolicyTopic("just make it", HISTORY)).toBeNull();
+  });
+
+  it("on: the turn that named the policy is the topic", () => {
+    vi.stubEnv("POLICY_CARRY_RETRIEVAL_ENABLED", "true");
+    expect(carriedPolicyTopic("just make it", HISTORY)).toBe(T2);
+  });
+
+  it("on: a turn with its own topic carries nothing", () => {
+    vi.stubEnv("POLICY_CARRY_RETRIEVAL_ENABLED", "true");
+    expect(carriedPolicyTopic("what is the dress code policy?", HISTORY)).toBeNull();
+  });
+});
+
+describe("which turns only say to go ahead", () => {
+  it.each(["just make it", "make it", "create it", "do it", "yes", "ok go ahead", "just make the form", "create the draft now", "please do it"])(
+    "%s",
+    (turn) => expect(isGoAheadTurn(turn)).toBe(true),
+  );
+
+  it.each([
+    "make it a written warning",
+    "create a coaching form for Wren Okafor",
+    "just make it say she was late",
+    "what is the dress code policy?",
+    T3,
+  ])("%s carries its own topic", (turn) => expect(isGoAheadTurn(turn)).toBe(false));
+
+  it("with no policy named earlier, the latest topic turn is searched; never an assistant turn", () => {
+    vi.stubEnv("POLICY_CARRY_RETRIEVAL_ENABLED", "true");
+    expect(carriedPolicyTopic("do it", [{ role: "user", content: "Wren was rude to a guest" }])).toBe("Wren was rude to a guest");
+    expect(carriedPolicyTopic("do it", [{ role: "assistant", content: "the visitors policy" }])).toBeNull();
+  });
+});
+
+/* HOW MANAGERS TYPE (Pau, 26 Oct 2026): the same reading in all lowercase and in sentence case. */
+const lower = (text: string) => text.toLowerCase();
+const sentence = (text: string) => text.charAt(0).toUpperCase() + text.slice(1).toLowerCase();
+
+describe("every register of a go-ahead", () => {
+  it.each(["just make it", "Just make it", "JUST MAKE IT", "do it", "Do it", "make it already", "Ok go ahead"])("%s", (turn) => {
+    expect(isGoAheadTurn(turn)).toBe(true);
+  });
+
+  it.each([T2, lower(T2), sentence(T2)])("on: the policy turn in any case is the topic (%s)", (policyTurn) => {
+    vi.stubEnv("POLICY_CARRY_RETRIEVAL_ENABLED", "true");
+    expect(carriedPolicyTopic("just make it", [{ role: "user", content: policyTurn }])).toBe(policyTurn);
+  });
+});
diff --git a/src/lib/ai/policy-carry-retrieval.ts b/src/lib/ai/policy-carry-retrieval.ts
new file mode 100644
index 00000000..7d4c657b
--- /dev/null
+++ b/src/lib/ai/policy-carry-retrieval.ts
@@ -0,0 +1,69 @@
+import { policyCarryRetrievalEnabled } from "@/lib/config/chat-quality-flags";
+import { namedPolicies } from "@/lib/forms/named-policy-section";
+
+/**
+ * ============================================================================
+ * "JUST MAKE IT" IS NOT A NEW TOPIC: THE POLICY ALREADY CITED IS SEARCHED
+ * (POLICY_CARRY_RETRIEVAL_ENABLED)
+ * ============================================================================
+ *
+ * Production, 25 Oct 2026 (conv_mvofuq3l2jae1be). Turn 2, "cite animals in
+ * the workplace policy", was answered from Animals in the Workplace p.30. Turn
+ * 4, "just make it", was searched on its own words; the excerpts that came
+ * back were soap and body-wash production recipes, and the reply said "the
+ * knowledge base doesn't have anything about an 'animals in the workplace'
+ * policy". A policy cited earlier in the chat was denied.
+ *
+ * A turn that only says to go ahead (make it, create it, do it, yes, ok, go
+ * ahead) asks nothing new. Its retrieval query is the manager's most recent
+ * turn that named a policy, or else the most recent turn with a topic of its
+ * own. Only the manager's words are used, never an assistant turn, and the
+ * model is still given the turn as typed. A turn with any topic of its own is
+ * searched as before. Off, null.
+ */
+
+const MAX_WORDS = 8;
+const MAX_HOPS = 8;
+
+const LEAD = String.raw`(?:(?:ok(?:ay)?|yes|yeah|yep|sure|please|pls|just|go\s+ahead\s+and|then|now|so|and|great|perfect|thanks|thank\s+you|cool|alright|all\s+right)[,.!\s]+)*`;
+const VERB = String.raw`(?:make|create|do|draft|build|write|start|generate|finish|send|submit|prepare|put\s+together|open|bring\s+up|pull\s+up|fill(?:\s+out)?)`;
+const OBJECT = String.raw`(?:it|this|that|one|them|the\s+(?:form|draft|card|ca|write[- ]?up|coaching(?:\s+form)?|corrective\s+action(?:\s+form)?|document|thing))`;
+const TAIL = String.raw`(?:\s+(?:now|please|pls|already|for\s+me|then|thanks|ok))*`;
+
+const GO_AHEAD = new RegExp(
+  String.raw`^\s*${LEAD}(?:${VERB}(?:\s+${OBJECT})?${TAIL}|go\s+ahead|do\s+it|yes|yeah|yep|ok(?:ay)?|sure|sounds\s+good|that'?s\s+(?:fine|right|correct)|proceed|continue)\s*[.!]*\s*$`,
+  "i",
+);
+
+/** Whether a turn only says to go ahead, with no topic of its own. */
+export function isGoAheadTurn(question: string): boolean {
+  const text = (question ?? "").trim();
+  if (text === "" || text.split(/\s+/).length > MAX_WORDS) return false;
+  return GO_AHEAD.test(text);
+}
+
+const NAMES_A_POLICY = /\bpolic(?:y|ies)\b|\bstandards? of conduct\b|\bdress code\b/i;
+
+/**
+ * The retrieval query for a go-ahead turn: the latest manager turn that named
+ * a policy, else the latest with a topic of its own. Null when the turn has a
+ * topic of its own, when nothing earlier does, or with the flag off.
+ */
+export function carriedPolicyTopic(
+  question: string,
+  history: readonly { role: string; content: string; error?: unknown }[],
+): string | null {
+  if (!policyCarryRetrievalEnabled() || !isGoAheadTurn(question)) return null;
+  let topic: string | null = null;
+  let hops = 0;
+  for (let index = history.length - 1; index >= 0 && hops <= MAX_HOPS; index -= 1) {
+    const turn = history[index]!;
+    if (turn.role !== "user" || turn.error || typeof turn.content !== "string") continue;
+    hops += 1;
+    const text = turn.content.trim();
+    if (text === "" || isGoAheadTurn(text)) continue;
+    if (NAMES_A_POLICY.test(text) || namedPolicies(text).length > 0) return text;
+    topic ??= text;
+  }
+  return topic;
+}
