# =============================================================================
# Ask Bubbles — environment variables (sanitized template)
# =============================================================================
#
# Copy to .env.local for local development. NEVER commit real values.
# Every value below is empty or a harmless example on purpose.
#
# ISOLATION. Ask Bubbles has its OWN Supabase project, its OWN Vercel project
# and its OWN credentials. Never paste a value from Ask Sunny (or any other
# product) into this deployment — not the Supabase keys, not the Anthropic
# key, not Woven credentials, not cron or ingest secrets.
#
# CLIENT vs SERVER. Only variables prefixed NEXT_PUBLIC_ are compiled into the
# browser bundle, and only non-secret values may carry that prefix. Everything
# else is read on the server only (modules marked `server-only`).
# `npm run verify:bundle` checks the built client bundle for leaks.
# -----------------------------------------------------------------------------


# --- Mode --------------------------------------------------------------------
# "true" runs the clearly-labelled demo build (sample users and content, no
# database). Must be set at BUILD time. A Vercel PRODUCTION build is always
# live regardless, unless NEXT_PUBLIC_ALLOW_DEMO_IN_PRODUCTION="true".
NEXT_PUBLIC_DEMO_MODE=false
# NEXT_PUBLIC_ALLOW_DEMO_IN_PRODUCTION=

# IANA zone that decides what "today" means for dates and analytics windows.
# NEXT_PUBLIC_BUSINESS_TIMEZONE=America/New_York

# The deployment's public origin, used for auth email links and callbacks.
# Falls back to Vercel's VERCEL_URL on previews.
NEXT_PUBLIC_SITE_URL=


# --- Supabase (the Ask Bubbles project only) ----------------------------------
# Public: project URL and PUBLISHABLE key (sb_publishable_...). Safe in the
# browser; the browser uses Supabase for authentication only — every data read
# goes through server routes.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# SERVER ONLY. The SECRET key (sb_secret_...). Bypasses RLS; never expose it,
# never prefix it NEXT_PUBLIC_, store it as a Sensitive variable in Vercel.
SUPABASE_SECRET_KEY=
# Legacy alternative, read only when SUPABASE_SECRET_KEY is unset.
# SUPABASE_SERVICE_ROLE_KEY=


# --- Assistant (Anthropic) -----------------------------------------------------
# SERVER ONLY. Without it the assistant reports that it is unavailable; it
# never falls back to invented answers.
ANTHROPIC_API_KEY=
# Optional overrides; defaults live in src/lib/config/models.ts.
# ANTHROPIC_MODEL=
# ANTHROPIC_EFFORT=


# --- Scheduled jobs and ingestion ---------------------------------------------
# SERVER ONLY. Vercel sends it as `Authorization: Bearer <value>` on cron
# calls. Without it every cron route refuses, including Vercel's.
CRON_SECRET=

# SERVER ONLY. Credentials for the report-ingestion endpoints (at least 24
# characters, or comma-separated `id:secret` entries). Give each its own value.
# No Buff City Soap report families exist yet, so these can stay empty.
# REPORTING_INGEST_SECRET=
# REPORTING_MANUAL_INGEST_SECRET=


# --- Forms ----------------------------------------------------------------------
# Writes the forms registry (src/config/company/forms) into the database on a
# local `next dev`/`next start`. Preview deployments are always refused. See
# src/lib/forms/template-sync-policy.ts.
# FORMS_TEMPLATE_SYNC_ENABLED=false


# --- Woven: employee directory (OFF by default) -------------------------------
# Observe-only. Nothing in this build creates, disables or re-scopes an account
# from Woven. See docs/woven.md for what to request from Buff City Soap.
# WOVEN_SYNC_ENABLED=false
# WOVEN_SYNC_WRITES_ENABLED=false
# WOVEN_SYNC_SCHEDULE_ENABLED=false
# WOVEN_VALIDATION_ENABLED=false
# WOVEN_API_BASE_URL=
# SERVER ONLY, Sensitive:
# WOVEN_SUBSCRIPTION_KEY=
# WOVEN_USERNAME=
# WOVEN_PASSWORD=
# REQUIRED before any sync runs: Buff City Soap's Woven CompanyID (a GUID).
# The read-only validation reports which company Woven would choose.
# WOVEN_COMPANY_ID=
# WOVEN_PLATFORM=
# Domains whose Woven email may be used to sign in. Unset = nobody eligible.
# WOVEN_LOGIN_EMAIL_DOMAINS=
# off | shadow. There is no apply mode.
# WOVEN_ACCESS_MODE=off
# Preview-only, one-off access code for the read-only connection test.
# WOVEN_VALIDATION_ACCESS_CODE=
# WOVEN_PAGE_SIZE=100
# WOVEN_MAX_DETAIL_REQUESTS_PER_RUN=150
# WOVEN_MIN_COMPLETENESS_PERCENT=80


# --- Woven: knowledge sync (OFF by default) -----------------------------------
# Buff City Soap's Woven company: Midwest Soap Makers. The same login can also
# open JB & Associates (Sun Tan City); the sync proves the company by its ID
# before every run and refuses anything else. See docs/woven.md.
# WOVEN_KNOWLEDGE_SYNC_ENABLED=false
# WOVEN_TEAM_BASE_URL=https://app.woven.team
# SERVER ONLY, Sensitive — a dedicated read-only integration login:
# WOVEN_TEAM_USERNAME=
# WOVEN_TEAM_PASSWORD=
# REQUIRED: the Woven company name as the account chooser shows it.
# WOVEN_TEAM_COMPANY=Midwest Soap Makers
# REQUIRED: the Woven Company ID. Must equal the id pinned in
# src/config/company/woven.ts, or the sync refuses to start.
# WOVEN_TEAM_COMPANY_ID=55839F24-9241-418C-8405-37BAF9A42A87
# Downloads NOT yet verified for this company. Leave OFF until one approved
# sample download has been checked (docs/woven.md). Off, those files are
# inventoried and reported by the dry run, never fetched.
# WOVEN_FILE_LIBRARY_DOWNLOAD_ENABLED=false
# WOVEN_HANDBOOK_DOWNLOAD_ENABLED=false


# --- Local development only ----------------------------------------------------
# Inert on any Vercel deployment.
# ALLOW_UNAUTHENTICATED_LIVE_ACCESS=
# Names hidden from the employee picker (test records), comma separated.
# ASK_BUBBLES_EXCLUDED_EMPLOYEE_NAMES=
# For scripts/bootstrap-admin.mjs: where the invitation link lands.
# ASK_BUBBLES_SITE_URL=
