index 00000000..50d43605
--- /dev/null
+++ b/src/lib/forms/revision-shown-fields.test.ts
@@ -0,0 +1,37 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import { shownFieldLines, updatedKeysShown } from "./revision-shown-fields";
+
+/*
+ * REVISION_REPLY_SHOWS_FIELDS_ENABLED (QA, the Ask Sunny sanitation report, 10 Nov 2026 18:49Z, port from Ask Sunny). After Create, "the 10 minute
+ * sanitaion in the morning" got "Updated the **Corrective Action Form** for <name>: Observation of Offense. Everything else
+ * on the form is as it was." and no card. The person is invented.
+ */
+const LABELS: Record<string, string> = { observation: "Observation of Offense", action_plan: "Action Plan" };
+const label = (key: string) => LABELS[key] ?? key;
+
+describe("REVISION_REPLY_SHOWS_FIELDS_ENABLED", () => {
+  afterEach(() => vi.unstubAllEnvs());
+
+  it("on: each changed text field as it now reads", () => {
+    vi.stubEnv("REVISION_REPLY_SHOWS_FIELDS_ENABLED", "true");
+    const values = { observation: "Observed:\nBrisa did not complete the 10-minute sanitation in the morning." };
+    expect(shownFieldLines(["observation"], values, label)).toEqual([
+      "",
+      "**Observation of Offense:** Observed:\nBrisa did not complete the 10-minute sanitation in the morning.",
+    ]);
+  });
+
+  it("a cleared field or one with no value shows nothing; a long value is cut", () => {
+    vi.stubEnv("REVISION_REPLY_SHOWS_FIELDS_ENABLED", "true");
+    expect(updatedKeysShown(["observation", "action_plan"], ["action_plan"])).toEqual(["observation"]);
+    expect(shownFieldLines(["observation"], {}, label)).toEqual([]);
+    const long = shownFieldLines(["observation"], { observation: "x".repeat(700) }, label)[1]!;
+    expect(long.endsWith("…")).toBe(true);
+  });
+
+  it("off: no lines", () => {
+    vi.stubEnv("REVISION_REPLY_SHOWS_FIELDS_ENABLED", "");
+    expect(shownFieldLines(["observation"], { observation: "Observed:\nx" }, label)).toEqual([]);
+  });
+});
diff --git a/src/lib/forms/revision-shown-fields.ts b/src/lib/forms/revision-shown-fields.ts
new file mode 100644
index 00000000..a15041f2
--- /dev/null
+++ b/src/lib/forms/revision-shown-fields.ts
@@ -0,0 +1,30 @@
+import { revisionReplyShowsFieldsEnabled } from "@/lib/config/chat-quality-flags";
+
+/**
+ * REVISION_REPLY_SHOWS_FIELDS_ENABLED (QA, the sibling app's sanitation report, 10 Nov 2026 18:49Z, port from the sibling app; default off). After Create,
+ * "the 10 minute sanitaion in the morning" got "Updated the **Corrective Action Form** for <name>: Observation of Offense.
+ * Everything else on the form is as it was." and no card: the change shows only in the open draft below, which the
+ * manager may not be looking at. On: the reply shows each changed text field as it now reads. Off: no lines.
+ */
+const LONGEST = 600;
+
+export function shownFieldLines(
+  keys: readonly string[],
+  values: Readonly<Record<string, string | undefined>>,
+  labelOf: (key: string) => string,
+): string[] {
+  if (!revisionReplyShowsFieldsEnabled()) return [];
+  const lines = keys.flatMap((key) => {
+    const value = (values[key] ?? "").trim();
+    const label = labelOf(key).trim();
+    if (!value || !label) return [];
+    const shown = value.length > LONGEST ? `${value.slice(0, LONGEST).trimEnd()}…` : value;
+    return [`**${label}:** ${shown}`];
+  });
+  return lines.length > 0 ? ["", ...lines] : [];
+}
+
+/** The keys this turn wrote and did not clear. */
+export function updatedKeysShown(written: readonly string[], cleared: readonly string[]): string[] {
+  return written.filter((key) => !cleared.includes(key));
+}
