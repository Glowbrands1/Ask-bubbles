+  const person = rest ? rosterSpelling(rest, names) : null;
+  if (!typed || !person) return response;
+  return {
+    ...response,
+    content: response.content.split(`**${typed}**`).join(`**${person}**`),
+    formProposal: { ...response.formProposal!, employeeName: person },
+  };
 }
 
