+import { describe, expect, it } from "vitest";
+
+import manual151 from "@/test/fixtures/jba-manual-production-151.json";
+
+import type { ManualChunk } from "./official-policy-manual";
+import { headingWithPrintedPage, printedPageLabel, withPolicyPagesOnCard } from "./policy-page-on-card";
+
+/**
+ * POLICY_PAGE_ON_CARD_ENABLED, the reader under it. The pages are checked
+ * against the production JBA Policy Manual rows (all 151, md5-verified against
+ * both apps' databases), not against the code: Standards of Conduct is printed
+ * on page 12 (PDF sheet 13), Late Opening on 15 (sheet 16), the Cell
+ * Phone/Smart Watch Policy on 19 (sheet 20).
+ */
+
+type Row = (typeof manual151.chunks)[number];
+
+const CHUNKS: ManualChunk[] = (manual151.chunks as Row[]).map((row) => ({
+  chunkIndex: row.chunk_index,
+  page: row.page,
+  printedPage: row.metadata.printedPage ?? null,
+  content: row.content,
+  section: row.section,
+  sections: row.metadata.sections,
+  locator: row.locator,
+}));
+
+describe("printed page for a manual heading (production manual)", () => {
+  it.each([
+    ["Standards of Conduct", "p.12"],
+    ["Late Opening", "p.15"],
+    ["Cell Phone/Smart Watch Policy", "p.19"],
+    ["Attendance", "p.14"],
+    ["Animals in the Workplace", "p.30"],
+    // The app's own section for the Dress Code box is "Dress Code for The Company" (OFFENSE_MANUAL_SECTIONS),
+    // printed on page 15 (chunk 44, PDF sheet 16): the page Direct policy cites on the draft.
+    ["Dress Code", "p.15"],
+  ])("%s is %s, the printed page and not the PDF sheet", (heading, label) => {
+    expect(printedPageLabel(heading, CHUNKS)).toBe(label);
+  });
+
+  it("a heading whose own chunk runs over two printed pages is a range", () => {
+    // Chunk 89: locator "Pages 26–27 — Employee Injury/Illness in the Workplace & Related Accommodations".
+    expect(printedPageLabel("Employee Injury/Illness in the Workplace & Related Accommodations", CHUNKS)).toBe("pp.26–27");
+  });
+
+  it("a policy the manual has no section for gets no page", () => {
+    expect(printedPageLabel("Violation of Company Policies", CHUNKS)).toBeNull();
+    expect(printedPageLabel("Under Performance", CHUNKS)).toBeNull();
+    expect(printedPageLabel("Visitors at Work", CHUNKS)).toBeNull();
+  });
+
+  it("a heading printed twice gets the page of the occurrence the app cites; one without a page gets none", () => {
+    const twice: ManualChunk[] = [
+      { chunkIndex: 0, page: 4, printedPage: 3, content: "", sections: [{ heading: "Breaks", page: 3 }] },
+      { chunkIndex: 1, page: 10, printedPage: 9, content: "", sections: [{ heading: "Breaks", page: 9 }] },
+    ];
+    // findManualSection takes the first sheet the heading is printed on; Direct policy cites the same one.
+    expect(printedPageLabel("Breaks", twice)).toBe("p.3");
+    const none: ManualChunk[] = [{ chunkIndex: 0, page: 4, content: "", sections: [{ heading: "Breaks", page: 0 }] }];
+    expect(printedPageLabel("Breaks", none)).toBeNull();
+  });
+
+  it("keeps the heading exactly as the app wrote it", () => {
+    expect(headingWithPrintedPage("Standards of Conduct", CHUNKS)).toBe("Standards of Conduct (JBA Policy Manual p.12)");
+  });
+});
+
+describe("the card's own policy lines get the page; nothing else changes", () => {
+  it("the remap card line (QA: Policy: Standards of Conduct, no page)", () => {
+    const card = [
+      "Here is the Corrective Action Form.",
+      "**Employee:** Test Employee",
+      "**What happened:** Failed to acknowledge policies in woven by the 10-15-26 deadline",
+      "**Policy:** Standards of Conduct, as you said",
+      "",
+      "What is their job title?",
+    ].join("\n");
+    expect(withPolicyPagesOnCard(card, CHUNKS)).toBe(
+      card.replace("**Policy:** Standards of Conduct, as you said", "**Policy:** Standards of Conduct (JBA Policy Manual p.12), as you said"),
+    );
+  });
+
+  it("the proposal's policy line, a bare Late Opening line and a 'reads as' line", () => {
+    expect(
+      withPolicyPagesOnCard(
+        "**Policy:** Late Opening, as you said. I'll quote that section from the current policy manual on the draft.",
+        CHUNKS,
+      ),
+    ).toBe(
+      "**Policy:** Late Opening (JBA Policy Manual p.15), as you said. I'll quote that section from the current policy manual on the draft.",
+    );
+    expect(withPolicyPagesOnCard("**Policy:** Late Opening", CHUNKS)).toBe("**Policy:** Late Opening (JBA Policy Manual p.15)");
+    expect(
+      withPolicyPagesOnCard("**Policy:** this reads as **Standards of Conduct** — a required deadline that was missed.", CHUNKS),
+    ).toBe("**Policy:** this reads as **Standards of Conduct** (JBA Policy Manual p.12) — a required deadline that was missed.");
+  });
+
+  it("the Dress Code line gets the page of the section the app cites (QA follow-up, 25 Oct 2026)", () => {
+    expect(withPolicyPagesOnCard("**Policy:** Dress Code, as you said", CHUNKS)).toBe(
+      "**Policy:** Dress Code (JBA Policy Manual p.15), as you said",
+    );
+  });
+
+  it("never alters the manager's words, a line that already has a page, or a name without one page", () => {
+    const unchanged = [
+      '**Policy:** "visitors at work", as you said. I\'ll look for that section in the current policy manual.',
+      "**Policy:** Standards of Conduct Policy, JBA Policy Manual p.12, as you said",
+      '**Policy:** "cell phone" reads as the policy manual\'s **Cell Phone/Smart Watch Policy** (page 19).',
+      "**Policy:** Violation of Company Policies, as you said. The policy manual has no single section to quote for it.",
+      "**Policy:** Attendance — missing the monthly meeting is an absence from a scheduled shift.",
+      "**What happened:** Standards of Conduct, as you said",
+      "Policy: Standards of Conduct, as you said",
+    ];
+    for (const line of unchanged) expect(withPolicyPagesOnCard(line, CHUNKS)).toBe(line);
+    const card = "**Policy:** Standards of Conduct, as you said";
+    expect(withPolicyPagesOnCard(card, [])).toBe(card);
+  });
+});
diff --git a/src/lib/forms/policy-page-on-card.ts b/src/lib/forms/policy-page-on-card.ts
new file mode 100644
index 00000000..8dffa71e
--- /dev/null
+++ b/src/lib/forms/policy-page-on-card.ts
@@ -0,0 +1,108 @@
+import { CA_POLICY_LABEL, type CaPolicyName } from "./ca-policy";
+import {
+  findManualSection,
+  headingKey,
+  OFFENSE_MANUAL_SECTIONS,
+  type ManualChunk,
+  type ManualSection,
+} from "./official-policy-manual";
+
+/**
+ * POLICY_PAGE_ON_CARD_ENABLED: the printed page beside the policy on the form
+ * card (QA, 25 Oct 2026: "Policy: Standards of Conduct" with no page; it is
+ * p.12. Late Opening is p.15).
+ *
+ * The page is the one of the section the app itself cites for that policy:
+ * `OFFENSE_MANUAL_SECTIONS` names it ("Dress Code" is the manual's "Dress Code
+ * for The Company", p.15), and `findManualSection` finds it on the sheet its
+ * heading is printed on — the same pick the draft's Direct policy line makes,
+ * so the card and the form name the same page. The page is the printed page
+ * stored with that heading in the chunk metadata, never the PDF sheet column.
+ * A policy the manual has no section for (Under Performance, Violation of
+ * Company Policies), or a section found only through the contents page, gets
+ * no page. A section whose own chunk the locator says runs over two printed
+ * pages ("Pages 26–27 — <heading>") is "pp.26–27".
+ *
+ * Only a line the app writes itself is changed, and only when it holds
+ * exactly one of the app's own policy names (`CARD_POLICY_HEADINGS`):
+ *
+ *   **Policy:** Standards of Conduct, as you said
+ *   **Policy:** Late Opening
+ *   **Policy:** this reads as **Standards of Conduct** — …
+ *
+ * A line that already gives a page, a phrase the manager typed (it is quoted:
+ * `**Policy:** "visitors at work", as you said`) and every other line stay as
+ * they are. The heading is never renamed. Off, nothing here runs.
+ */
+
+const MANUAL = "JBA Policy Manual";
+
+/** The policy names the app writes on a card itself, from its own readers. */
+export const CARD_POLICY_HEADINGS: readonly string[] = [
+  ...new Set([...Object.values(CA_POLICY_LABEL), "Late Opening"]),
+];
+
+/** Labels whose box names no section of the manual, by design (see `OFFENSE_MANUAL_SECTIONS`). */
+const NO_SECTION: ReadonlySet<CaPolicyName> = new Set(["under_performance", "company_policies"]);
+
+/** The manual section the app cites for a policy name, or null. */
+export function citedSectionFor(heading: string, chunks: readonly ManualChunk[]): ManualSection | null {
+  const key = headingKey(heading);
+  if (!key) return null;
+  const label = (Object.keys(CA_POLICY_LABEL) as CaPolicyName[]).find((name) => headingKey(CA_POLICY_LABEL[name]) === key);
+  if (label && NO_SECTION.has(label)) return null;
+  const mapped = label ? (OFFENSE_MANUAL_SECTIONS[label === "attendance" ? "tardiness" : label]?.headings ?? null) : null;
+  const section = findManualSection(chunks, mapped ?? [heading], false);
+  if (!section || section.foundBy === "contents") return null;
+  return Number.isInteger(section.page) && section.page > 0 ? section : null;
+}
+
+/** "p.12", "pp.26–27", or null when the app cites no section of the manual for the name. */
+export function printedPageLabel(heading: string, chunks: readonly ManualChunk[]): string | null {
+  const section = citedSectionFor(heading, chunks);
+  if (!section) return null;
+  const chunk = chunks.find((item) => item.chunkIndex === section.chunkIndex);
+  return pageLabel(section.page, chunk?.locator ?? null, headingKey(section.heading));
+}
+
+function pageLabel(page: number, locator: string | null, key: string): string {
+  const range = /^Pages\s+(\d+)\s*[–-]\s*(\d+)\s*[—–-]\s*(.+)$/i.exec(locator?.trim() ?? "");
+  if (range && Number(range[1]) === page && Number(range[2]) > page && headingKey(range[3]!) === key) {
+    return `pp.${page}–${range[2]}`;
+  }
+  return `p.${page}`;
+}
+
+/** "Standards of Conduct (JBA Policy Manual p.12)", or null when the app cites no section for the name. */
+export function headingWithPrintedPage(heading: string, chunks: readonly ManualChunk[]): string | null {
+  const label = printedPageLabel(heading, chunks);
+  return label ? `${heading} (${MANUAL} ${label})` : null;
+}
+
+const HAS_PAGE = /\bpp?\.\s*\d|\bpages?\s+\d/i;
+const AS_YOU_SAID = /^(\*\*Policy:\*\* )(.+?)(, as you said\b.*)$/;
+const BARE = /^(\*\*Policy:\*\* )(.+?)(\.?)$/;
+const READS_AS = /^(\*\*Policy:\*\* this reads as \*\*)(.+?)(\*\*)( — .*)$/;
+
+/** The card's own policy lines, each with its printed page where the manual gives one. */
+export function withPolicyPagesOnCard(content: string, chunks: readonly ManualChunk[]): string {
+  if (chunks.length === 0 || !content.includes("**Policy:**")) return content;
+  const lines = content.split("\n").map((line) => {
+    if (!line.startsWith("**Policy:** ") || HAS_PAGE.test(line)) return line;
+    const reads = READS_AS.exec(line);
+    if (reads) {
+      const label = ownHeading(reads[2]!) ? printedPageLabel(reads[2]!, chunks) : null;
+      return label ? `${reads[1]}${reads[2]}${reads[3]} (${MANUAL} ${label})${reads[4]}` : line;
+    }
+    const said = AS_YOU_SAID.exec(line) ?? BARE.exec(line);
+    if (!said || !ownHeading(said[2]!)) return line;
+    const cited = headingWithPrintedPage(said[2]!, chunks);
+    return cited ? `${said[1]}${cited}${said[3]}` : line;
+  });
+  const next = lines.join("\n");
+  return next === content ? content : next;
+}
+
+function ownHeading(text: string): boolean {
+  return CARD_POLICY_HEADINGS.includes(text);
+}
