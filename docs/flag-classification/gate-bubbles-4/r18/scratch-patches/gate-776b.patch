+import { afterAll, describe, expect, it, vi } from "vitest";
+
+/*
+ * QA (R744, 12 Nov 2026): these tests say an Assistant Manager creates no forms, which holds only with
+ * NEXT_PUBLIC_ASSISTANT_MANAGER_CREATE_ENABLED off. It is on in production, where the answer correctly names the
+ * Assistant Manager. The permission matrix reads it when `config/company/access.ts` is imported, so it is pinned off
+ * before the imports (hoisted) and restored after.
+ */
+const amCreate = vi.hoisted(() => {
+  const saved = process.env.NEXT_PUBLIC_ASSISTANT_MANAGER_CREATE_ENABLED;
+  delete process.env.NEXT_PUBLIC_ASSISTANT_MANAGER_CREATE_ENABLED;
+  return { saved };
+});
+afterAll(() => {
+  if (amCreate.saved === undefined) delete process.env.NEXT_PUBLIC_ASSISTANT_MANAGER_CREATE_ENABLED;
+  else process.env.NEXT_PUBLIC_ASSISTANT_MANAGER_CREATE_ENABLED = amCreate.saved;
+});
+
+import { buildFormsGuideAnswer, readFormsGuideQuestion, type GuideTemplate } from "./forms-guide";
+import { guideAccess, seedTemplates, withheldTemplates } from "./forms-guide-answer";
+import type { Role } from "@/types";
+
+/**
+ * ============================================================================
+ * THE FORMS GUIDE (FORMS_GUIDE_ENABLED) — "READ THE FORMS AND THAT SHOULD BE
+ * THE ANSWER"
+ * ============================================================================
+ *
+ * The owner, 26 Oct 2026: "both sunny and bubbles should also guide managers
+ * on the differences of each form, like what is a CA, what is coaching and so
+ * on. Read the forms and that should be the answer."
+ *
+ * The openers below are managers' own words, as QA collected them (most
+ * typed all lowercase; "which forms can i create here?" is the starter chip
+ * managers used three times in Ask Bubbles). Each runs as typed and in
+ * sentence case. The answers are built from this app's templates and role
+ * matrix (`config/company/access.ts`); the fixture-change test proves no
+ * sentence about a form is fixed text. Ported from the sibling app: the same
+ * mechanism, this app's own templates, roles and labels.
+ */
+
+/* Hidden-aware, exactly as the guide reads them: config/company/forms/hidden.ts decides both. */
+const TEMPLATES = seedTemplates();
+const WITHHELD = withheldTemplates();
+
+function answer(
+  question: string,
+  role: Role | null,
+  templates: readonly GuideTemplate[] = TEMPLATES,
+  withheld: readonly GuideTemplate[] = WITHHELD,
+) {
+  const reading = readFormsGuideQuestion(question);
+  if (!reading) return null;
+  return buildFormsGuideAnswer<Role>({ reading, templates, withheld, access: guideAccess(role), productName: "Ask Bubbles" });
+}
+
+const isEpp = (entry: GuideTemplate) => entry.layoutFamily === "epp" || entry.layoutFamily === "dmit_epp";
+const ALL_BUNDLED = [...TEMPLATES, ...WITHHELD];
+/** The library as it reads with the EPP keys hidden, and with them shown — the answer must hold either way. */
+const EPP_HIDDEN = { templates: ALL_BUNDLED.filter((entry) => !isEpp(entry)), withheld: ALL_BUNDLED.filter(isEpp) };
+const EPP_SHOWN = { templates: ALL_BUNDLED.filter(isEpp).concat(TEMPLATES.filter((entry) => !isEpp(entry))), withheld: [] };
+
+function sentenceCase(text: string): string {
+  return text.charAt(0).toUpperCase() + text.slice(1);
+}
+
+function both(wording: string): string[] {
+  return [wording, sentenceCase(wording)];
+}
+
+const template = (key: string) => TEMPLATES.find((entry) => entry.key === key)!;
+const CA = template("dpoa");
+const COACHING = template("coaching");
+
+describe("the managers' openers, as typed and in sentence case", () => {
+  it.each([
+    ...both("what is a ca?"),
+    ...both("what is a ca"),
+    ...both("what is dpoa"),
+    ...both("what is ca"),
+    ...both("whats a ca"),
+    ...both("what is a c/a"),
+    "What's a C/A?",
+    "whats a c.a.",
+  ])(
+    "%s explains the Corrective Action Form from its template",
+    (wording) => {
+      const text = answer(wording, "location_manager");
+      expect(text).not.toBeNull();
+      expect(text).toContain("**Corrective Action Form**");
+      expect(text).toContain(CA.description);
+      expect(text).toContain("Type of Warning (Verbal Warning, Written Warning, Termination, Demotion)");
+      expect(text).toContain('say "create a corrective action form for <name>" to start it.');
+    },
+  );
+
+  it.each([...both("what is coaching"), "what is a cf", "what is caoching"])("%s explains the Coaching Form", (wording) => {
+    const text = answer(wording, "location_manager");
+    expect(text).toContain("**Coaching Form**");
+    expect(text).toContain(COACHING.description);
+    expect(text).not.toContain("**Corrective Action Form**");
+  });
+
+  it.each([
+    ...both("difference between coaching and ca"),
+    ...both("when do i use a coaching form vs a corrective action"),
+    ...both("ca vs coaching"),
+  ])("%s puts both forms side by side", (wording) => {
+    const text = answer(wording, "location_manager")!;
+    expect(text).toContain(`**Coaching Form** — ${COACHING.description}`);
+    expect(text).toContain(`**Corrective Action Form** — ${CA.description}`);
+  });
+
+  it.each(both("what is an epp"))("%s follows hidden.ts: every EPP when shown, \"not available\" when hidden", (wording) => {
+    const text = answer(wording, "district_manager")!;
+    const epps = TEMPLATES.filter(isEpp);
+    if (epps.length > 0) {
+      expect(text).toContain(epps.length === 1 ? `**${epps[0].name}**` : `There are ${epps.length} EPP forms:`);
+      for (const epp of epps) expect(text).toContain(`**${epp.name}**`);
+    } else {
+      expect(text).toContain("The EPP isn't a form available in Ask Bubbles.");
+    }
+  });
+
+  it.each(both("what is an epp"))("%s with the EPP keys hidden: not available here, no form named", (wording) => {
+    const text = answer(wording, "district_manager", EPP_HIDDEN.templates, EPP_HIDDEN.withheld)!;
+    expect(text).toContain("The EPP isn't a form available in Ask Bubbles.");
+    expect(text).toContain('Ask "which forms can I create here?" to see the forms you can use.');
+    for (const epp of EPP_HIDDEN.withheld) expect(text).not.toContain(epp.name);
+    expect(text).not.toMatch(/tanning|sun tan/i);
+  });
+
+  it.each(both("what is an epp"))("%s with the EPP keys shown: every EPP template", (wording) => {
+    const text = answer(wording, "district_manager", EPP_SHOWN.templates, EPP_SHOWN.withheld)!;
+    const epps = EPP_SHOWN.templates.filter(isEpp);
+    expect(epps.length).toBeGreaterThan(1);
+    expect(text).toContain(`There are ${epps.length} EPP forms:`);
+  });
+
+  it("a hidden form in a comparison is said to be unavailable; the other is still explained", () => {
+    const text = answer("epp vs coaching", "district_manager", EPP_HIDDEN.templates, EPP_HIDDEN.withheld)!;
+    expect(text).toContain("The EPP isn't a form available in Ask Bubbles.");
+    expect(text).toContain("**Coaching Form** — ");
+  });
+
+  it.each(both("what is a policy review"))("%s explains the Policy Review", (wording) => {
+    const text = answer(wording, "location_manager")!;
+    expect(text).toContain(`**Policy Review** — ${template("policy-review").description}`);
+  });
+
+  it.each(both("what form do i use for someone who quit"))("%s names the separation form", (wording) => {
+    const exit = TEMPLATES.find((entry) => entry.category === "separation")!;
+    const text = answer(wording, "location_manager")!;
+    expect(text).toContain(`The form for this is the ${exit.name}.`);
+    expect(text).toContain(exit.description);
+  });
+
+  it.each(both("which forms can i create here?"))("%s lists exactly the role's creatable forms", (wording) => {
+    const text = answer(wording, "location_manager")!;
+    const access = guideAccess("location_manager");
+    const mine = TEMPLATES.filter((entry) => access.may("location_manager", entry.requiredPermission));
+    expect(text).toContain(`As a Location Manager you can create these ${mine.length} forms in Ask Bubbles:`);
+    for (const entry of TEMPLATES) {
+      if (mine.includes(entry)) expect(text).toContain(`- ${entry.name}`);
+      else expect(text).not.toContain(`- ${entry.name} `);
+    }
+    // EPPs are District Manager and above in config/company/access.ts.
+    expect(text).not.toContain("SDIT EPP");
+  });
+});
+
+describe("the answer is the template, not fixed text", () => {
+  it("changing the template's description changes the answer", () => {
+    const edited = TEMPLATES.map((entry) =>
+      entry.key === "dpoa" ? { ...entry, description: "Fixture wording: the second formal step." } : entry,
+    );
+    const before = answer("what is a ca?", "location_manager")!;
+    const after = answer("what is a ca?", "location_manager", edited)!;
+    expect(before).toContain(CA.description);
+    expect(after).toContain("Fixture wording: the second formal step.");
+    expect(after).not.toContain(CA.description);
+  });
+
+  it("changing a section heading in the published document changes what it records", () => {
+    const edited = TEMPLATES.map((entry) =>
+      entry.key === "dpoa" && entry.document
+        ? {
+            ...entry,
+            document: {
+              ...entry.document,
+              blocks: entry.document.blocks.map((block) =>
+                block.kind === "section" && block.label === "Type of Warning" ? { ...block, label: "Level of Warning" } : block,
+              ),
+            },
+          }
+        : entry,
+    );
+    expect(answer("what is a ca", "location_manager", edited)).toContain("Level of Warning (Verbal Warning");
+  });
+
+  it("a template with no description is described by its fields, never guessed", () => {
+    const edited = TEMPLATES.map((entry) => (entry.key === "dpoa" ? { ...entry, description: "" } : entry));
+    const text = answer("what is a ca", "location_manager", edited)!;
+    expect(text).toContain("**Corrective Action Form**\n");
+    expect(text).toContain("What its fields show: Employee Information; Type of Warning");
+    expect(text).not.toContain(CA.description);
+  });
+
+  it("a form that is not published is not explained — the turn goes on as before", () => {
+    const unpublished = TEMPLATES.filter((entry) => entry.key !== "policy-review");
+    expect(answer("what is a policy review", "location_manager", unpublished)).toBeNull();
+  });
+});
+
+describe("who can create it, per role", () => {
+  it.each(["employee", "assistant_manager"] as const)(
+    "%s is told what a Corrective Action is and that they cannot create it",
+    (role) => {
+      const text = answer("what is a ca?", role)!;
+      expect(text).toContain(CA.description);
+      expect(text).toContain("Who can create it: Location Manager, District Manager, Regional Manager, Admin, Owner.");
+      expect(text).toMatch(/Your role \((Team Member|Assistant Manager)\) can't create this one; your [A-Z][a-z]+ [A-Z][a-z]+ can\./);
+      expect(text).not.toContain("to start it");
+    },
+  );
+
+  it.each(["employee", "assistant_manager"] as const)("%s can create no forms here", (role) => {
+    // access.ts: the assistant manager sees the Forms Register but creates none.
+    expect(answer("which forms can i create here?", role)).toMatch(/^Your role \([^)]+\) can't create forms in Ask Bubbles\./);
+  });
+
+  it("a Location Manager is told the EPPs are District Manager and above (when the EPPs are shown)", () => {
+    const text = answer("what is an epp", "location_manager", EPP_SHOWN.templates, EPP_SHOWN.withheld)!;
+    expect(text).toContain("Who can create it: District Manager, Regional Manager, Admin, Owner.");
+    expect(text).toContain("Your role (Location Manager) can't create this one; your District Manager can.");
+  });
+
+  it("hidden templates (config/company/forms/hidden.ts) are never listed", () => {
+    const text = answer("Which forms can I create here?", "owner")!;
+    expect(WITHHELD.length).toBeGreaterThan(0);
+    for (const hidden of WITHHELD) expect(text).not.toContain(`- ${hidden.name}`);
+  });
+
+  it("a District Manager's list includes the EPPs exactly when hidden.ts shows them", () => {
+    const text = answer("Which forms can I create here?", "district_manager")!;
+    expect(text).toContain("As a District Manager you can create these");
+    for (const epp of TEMPLATES.filter(isEpp)) expect(text).toContain(`- ${epp.name}`);
+    for (const epp of WITHHELD.filter(isEpp)) expect(text).not.toContain(`- ${epp.name}`);
+  });
+});
+
+describe("Could this break: sentences that merely contain 'form' or 'ca' are not read", () => {
+  it.each([
+    "what is the ca for california sales tax",
+    "What is the CA for California sales tax?",
+    "performance review",
+    "what is a performance review",
+    "ca for Avery Holt",
+    "CA for Avery Holt",
+    "create a coaching form for Avery Holt",
+    "create a corrective action for Avery Holt",
+    "coaching for Avery Holt",
+    "should i do a coaching or corrective action",
+    "what is our attendance policy",
+    "what is the dress code",
+    "what is a coaching form for Avery Holt",
+    "show me the form",
+    "what form do i use for Avery Holt",
+    "ca",
+    "coaching",
+    // QA, 26 Oct: glossary and metric questions stay as they are.
+    "what is ppta",
+    "what is ach",
+    "what is a district manager",
+    // QA, 26 Oct: the coaching-conversation chip keeps its own path.
+    "help me prepare for a coaching conversation",
+    "Help me prepare for a coaching conversation",
+  ])("%s", (wording) => {
+    expect(answer(wording, "location_manager")).toBeNull();
+  });
+});
+
+/*
+ * NEVER-BREAK (owner's order via QA, 26 Oct 2026): the short commands and the
+ * exit-process knowledge answer, confirmed live, are never read by the guide.
+ */
+describe("NEVER-BREAK: short commands and the exit-process answer are not the guide", () => {
+  it.each([
+    ...both("what is the exit process?"),
+    ...both("what is the exit process"),
+    ...both("ca Avery Holt late today"),
+    ...both("ca for Avery Holt verbal 25 deduct"),
+    ...both("coach Avery Holt"),
+    ...both("exit Avery Holt"),
+    ...both("exit for Avery Holt"),
+    ...both("ca"),
+    ...both("coach"),
+    ...both("exit"),
+  ])("%s", (wording) => {
+    expect(readFormsGuideQuestion(wording)).toBeNull();
+    expect(answer(wording, "district_manager")).toBeNull();
+  });
+});
+
+/*
+ * Tester replay S27 (26 Oct 2026), the tester's exact words: a request
+ * for a form that is about no one is explained from the template, not answered
+ * by asking for an employee.
+ */
+describe("a generic form request is explained from the template", () => {
+  const WORDING = "can you make a generic policy review form that works for any employee";
+
+  it.each(both(WORDING))("%s explains the Policy Review and how to start it for someone", (wording) => {
+    const text = answer(wording, "district_manager")!;
+    expect(text).toContain("Forms in Ask Bubbles are filled in for one employee at a time");
+    expect(text).toContain(`**Policy Review** — ${template("policy-review").description}`);
+    expect(text).toContain('say "create a policy review for <name>" to start it.');
+    expect(text).toContain("open Form Templates and press Preview PDF");
+  });
+
+  it("the answer follows the template's description", () => {
+    const edited = TEMPLATES.map((entry) =>
+      entry.key === "policy-review" ? { ...entry, description: "Fixture: a reviewed policy, signed." } : entry,
+    );
+    expect(answer(WORDING, "district_manager", edited)).toContain("**Policy Review** — Fixture: a reviewed policy, signed.");
+  });
+
+  it("a role that does not manage templates is not sent to Form Templates", () => {
+    const text = answer(WORDING, "location_manager")!;
+    expect(text).toContain("**Policy Review** — ");
+    expect(text).not.toContain("Form Templates");
+  });
+
+  it("an employee is told they cannot create it", () => {
+    expect(answer(WORDING, "employee")).toMatch(/Your role \([^)]+\) can't create this one/);
+  });
+
+  it.each([
+    ...both("create a policy review for Avery Holt"),
+    ...both("create a coaching form for Avery Holt using the template"),
+    ...both("create a ca for everyone at the store"),
+    ...both("make a policy review for Avery Holt"),
+    // QA-2 probes: a negation, or a generic word beside a real name, is never the guide.
+    ...both("don't make a generic form"),
+    ...both("never create a policy review"),
+    ...both("make a generic policy review for Avery Holt"),
+    ...both("make a generic policy review form for Avery Holt"),
+    ...both("create a template coaching form for Avery Holt"),
+    ...both("can you make a coaching form for Avery Holt that works for any employee"),
+  ])("NEVER-BREAK: %s still creates", (wording) => {
+    expect(readFormsGuideQuestion(wording)).toBeNull();
+  });
+});
