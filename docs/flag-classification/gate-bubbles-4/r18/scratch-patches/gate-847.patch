@@ -0,0 +1,33 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import { withoutApproverClauses } from "./approver-title";
+import { extractJobTitle } from "./proposal";
+
+/* APPROVER_TITLE_NOT_EMPLOYEE_ENABLED (QA's r37 live check in the sibling app, 12 Nov 2026; ported; names invented). */
+const titleOf = (text: string) => extractJobTitle(withoutApproverClauses(text));
+
+describe("APPROVER_TITLE_NOT_EMPLOYEE", () => {
+  afterEach(() => vi.unstubAllEnvs());
+
+  it.each([
+    "CA for Odalys Pemberley, probably termination once the DM approves",
+    "CA for Odalys Pemberley, termination after my district manager signs off",
+    "CA for Odalys Pemberley, pending the DM's approval",
+    "CA for Odalys Pemberley, waiting on the DM",
+    "CA for Odalys Pemberley, needs DM approval",
+  ])("on: %j states no title for the employee", (text) => {
+    vi.stubEnv("APPROVER_TITLE_NOT_EMPLOYEE_ENABLED", "true");
+    expect(titleOf(text)).toBeNull();
+  });
+
+  it("on: a title stated for her stays", () => {
+    vi.stubEnv("APPROVER_TITLE_NOT_EMPLOYEE_ENABLED", "true");
+    expect(titleOf("CA for Odalys Pemberley, she is a district manager, she missed the meeting")).toBe("District Manager");
+    expect(titleOf("CA for Odalys Pemberley, our store manager, termination once the DM approves")).toBe("Store Manager");
+  });
+
+  it("off: the text as given", () => {
+    vi.stubEnv("APPROVER_TITLE_NOT_EMPLOYEE_ENABLED", "");
+    expect(titleOf("CA for Odalys Pemberley, probably termination once the DM approves")).toBe("District Manager");
+  });
+});
diff --git a/src/lib/forms/approver-title.ts b/src/lib/forms/approver-title.ts
new file mode 100644
index 00000000..f20afb38
--- /dev/null
+++ b/src/lib/forms/approver-title.ts
@@ -0,0 +1,29 @@
+import { approverTitleNotEmployeeEnabled } from "@/lib/config/chat-quality-flags";
+
+/*
+ * ============================================================================
+ * "ONCE THE DM APPROVES" NAMES WHO APPROVES, NOT THE EMPLOYEE'S TITLE (APPROVER_TITLE_NOT_EMPLOYEE_ENABLED)
+ * ============================================================================
+ *
+ * QA's r37 live check in the sibling app (12 Nov 2026; ported; names invented): "CA for <A>, probably termination once the
+ * DM approves" put "Job title: District Manager" on the card. A title in a clause about who approves, signs off or is
+ * waited on is that approver's. These clauses are taken out before the title is read again (`ai/title-of-the-employee.ts`).
+ * Pure; off, the text as given.
+ */
+const WHO = String.raw`(?:the|my|our|your|a|an)\s+(?:[\p{L}/&.-]+\s+){0,2}?[\p{L}/&.-]+`;
+const APPROVER_CLAUSES: readonly RegExp[] = [
+  // "once the DM approves", "after my district manager signs off", "until the DM okays it", "when the SD reviews it"
+  new RegExp(String.raw`\b(?:once|after|when|until|till|unless|if|before|pending)\s+${WHO}\s+(?:approves?|approved|signs?\s+off|signed\s+off|ok(?:ay)?s|ok(?:ay)?ed|agrees?|reviews?|confirms?|decides?|gives\s+(?:the\s+)?(?:ok|okay|go[- ]ahead))\b`, "giu"),
+  // "the DM's approval", "my district manager's sign-off"
+  new RegExp(String.raw`\b${WHO}['’]s\s+(?:approval|sign[- ]?off|ok(?:ay)?|go[- ]ahead|decision|review)\b`, "giu"),
+  // "waiting on the DM", "pending the DM", "needs the DM to approve", "with the DM's approval"
+  new RegExp(String.raw`\b(?:waiting\s+(?:on|for)|pending|needs?|need\s+to\s+get|run\s+(?:it\s+)?by|check\s+with)\s+${WHO}(?:\s+to\s+(?:approve|sign\s+off|ok(?:ay)?|review))?\b`, "giu"),
+  // "DM approval", "GM sign-off"
+  /\b(?:dm|gm|sm|district\s+manager|general\s+manager|store\s+(?:manager|director))\s+(?:approval|sign[- ]?off)\b/giu,
+];
+
+/** The text with every approver clause taken out (flag on); as given otherwise. */
+export function withoutApproverClauses(text: string): string {
+  if (!approverTitleNotEmployeeEnabled()) return text;
+  return APPROVER_CLAUSES.reduce((rest, clause) => rest.replace(clause, " "), text ?? "");
+}
