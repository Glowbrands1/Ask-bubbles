@@ -0,0 +1,38 @@
+import { afterEach, describe, expect, it } from "vitest";
+
+import type { AskResponse } from "@/lib/ai/types";
+
+import { withoutSelectionOnOpenCard } from "./no-selection-on-open-card";
+
+/*
+ * NO_SELECTION_ON_OPEN_CARD_ENABLED (Pau's sf-b6). The replay pack runs the chat with the manager's words:
+ * `nov5-pau-sf-b6-cases.ts`.
+ */
+const choice = (templateKey: string) => ({ templateKey, templateName: templateKey, description: "" });
+const answer = {
+  content: "I can add that detail as the factual account on the form.\n\nBased on what you've described, I can prepare:",
+  citations: [],
+  coverage: "not_applicable",
+  recommendedVideoIds: [],
+  formSelection: { primary: choice("dpoa"), additional: [choice("coaching")] },
+} as unknown as AskResponse;
+
+afterEach(() => {
+  delete process.env.NO_SELECTION_ON_OPEN_CARD_ENABLED;
+});
+
+describe("the form choice with a card on screen", () => {
+  it("is left off, with its lead, when it offers the card's own form; as before with the flag off", () => {
+    expect(withoutSelectionOnOpenCard(answer, "dpoa")).toBe(answer);
+    process.env.NO_SELECTION_ON_OPEN_CARD_ENABLED = "true";
+    const read = withoutSelectionOnOpenCard(answer, "dpoa");
+    expect(read.formSelection).toBeUndefined();
+    expect(read.content).toBe("I can add that detail as the factual account on the form.");
+  });
+
+  it("stays with no card on screen, or a card of a form it does not offer", () => {
+    process.env.NO_SELECTION_ON_OPEN_CARD_ENABLED = "true";
+    expect(withoutSelectionOnOpenCard(answer, undefined)).toBe(answer);
+    expect(withoutSelectionOnOpenCard(answer, "exit")).toBe(answer);
+  });
+});
diff --git a/src/lib/forms/no-selection-on-open-card.ts b/src/lib/forms/no-selection-on-open-card.ts
new file mode 100644
index 00000000..ca55c5fb
--- /dev/null
+++ b/src/lib/forms/no-selection-on-open-card.ts
@@ -0,0 +1,28 @@
+import { noSelectionOnOpenCardEnabled } from "@/lib/config/chat-quality-flags";
+import { formOpportunityLead } from "@/lib/forms/form-opportunity";
+import type { AskResponse } from "@/lib/ai/types";
+
+/**
+ * ============================================================================
+ * WITH A CARD ON SCREEN, NO "I CAN PREPARE:" FOR THE SAME FORM (NO_SELECTION_ON_OPEN_CARD_ENABLED)
+ * ============================================================================
+ *
+ * Pau's sf-b6 (this app's production, 4 Nov 2026; port from the sibling app): with <A>'s Corrective Action card on screen,
+ * "can you have it include that we recieved a customer complaint from Sunday 11-1, …" was answered by the model, and
+ * then the app added the form choice again — "Based on what you've described, I can prepare:" with the Corrective
+ * Action Form first — so the reply ended at a colon above a choice of the form already being written.
+ *
+ * With the flag on, when the browser says a card of one form is on screen (`continueProposalTemplateKey`) and the
+ * answer's form choice offers that same form, the choice and its lead are left off: the card on screen is the form. Any
+ * other answer is left as it is. Pure.
+ */
+export function withoutSelectionOnOpenCard(answer: AskResponse, continueTemplateKey: string | undefined): AskResponse {
+  const selection = answer.formSelection;
+  if (!noSelectionOnOpenCardEnabled() || !continueTemplateKey || !selection) return answer;
+  const offered = [selection.primary, ...(selection.additional ?? [])].map((choice) => choice.templateKey);
+  if (!offered.includes(continueTemplateKey)) return answer;
+  const { formSelection: _dropped, ...rest } = answer;
+  void _dropped;
+  const lead = formOpportunityLead().replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
+  return { ...rest, content: rest.content.replace(new RegExp(`\\n*${lead}\\s*$`), "").trimEnd() };
+}
