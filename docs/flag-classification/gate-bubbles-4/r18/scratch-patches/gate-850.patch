@@ -0,0 +1,31 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import { GO_AHEAD_ASK, withGoAheadAsk } from "./go-ahead-ask";
+
+/* GO_AHEAD_ASKS_WHO_AND_FORM_ENABLED (QA's r37 live check, 12 Nov 2026; low): QA's turns. */
+const POLICY = [{ role: "user", content: "cite the animals in the workplace policy" }, { role: "assistant", content: "A grounded answer." }];
+const ANSWER = { content: "I need two things first: which employee this is for, and you'll need to ask for it by name." };
+
+describe("GO_AHEAD_ASKS_WHO_AND_FORM", () => {
+  afterEach(() => vi.unstubAllEnvs());
+
+  it("on: \"just make it\" after a policy question is one short question", () => {
+    vi.stubEnv("GO_AHEAD_ASKS_WHO_AND_FORM_ENABLED", "true");
+    expect(withGoAheadAsk(ANSWER, POLICY, "just make it").content).toBe(GO_AHEAD_ASK);
+    expect(withGoAheadAsk(ANSWER, POLICY, "ok make it").content).toBe(GO_AHEAD_ASK);
+  });
+
+  it("on: a card or a form request in the chat, no policy named, or not a go-ahead: as given", () => {
+    vi.stubEnv("GO_AHEAD_ASKS_WHO_AND_FORM_ENABLED", "true");
+    expect(withGoAheadAsk(ANSWER, [...POLICY, { role: "assistant", content: "card", formProposal: {} }], "just make it")).toBe(ANSWER);
+    expect(withGoAheadAsk(ANSWER, [{ role: "user", content: "create a coaching form for Wren Tallis, cite the dress code policy" }], "just make it")).toBe(ANSWER);
+    expect(withGoAheadAsk(ANSWER, [{ role: "user", content: "what are the store hours" }], "just make it")).toBe(ANSWER);
+    expect(withGoAheadAsk(ANSWER, POLICY, "what does it say about service dogs")).toBe(ANSWER);
+    expect(withGoAheadAsk({ ...ANSWER, formProposal: { employeeName: null } }, POLICY, "just make it").content).toBe(ANSWER.content);
+  });
+
+  it("off: as given", () => {
+    vi.stubEnv("GO_AHEAD_ASKS_WHO_AND_FORM_ENABLED", "");
+    expect(withGoAheadAsk(ANSWER, POLICY, "just make it")).toBe(ANSWER);
+  });
+});
diff --git a/src/lib/forms/go-ahead-ask.ts b/src/lib/forms/go-ahead-ask.ts
new file mode 100644
index 00000000..00db19df
--- /dev/null
+++ b/src/lib/forms/go-ahead-ask.ts
@@ -0,0 +1,38 @@
+import { isGoAheadTurn } from "@/lib/ai/policy-carry-retrieval";
+import { goAheadAsksWhoAndFormEnabled } from "@/lib/config/chat-quality-flags";
+
+import { detectTemplateIntent } from "./template-intent";
+
+/*
+ * ============================================================================
+ * "JUST MAKE IT" AFTER A POLICY QUESTION ASKS ONE SHORT QUESTION (GO_AHEAD_ASKS_WHO_AND_FORM_ENABLED)
+ * ============================================================================
+ *
+ * QA's r37 live check in the sibling app (12 Nov 2026; ported; low): after "cite the animals in the workplace policy", "just make
+ * it" replied "I need two things first: which employee … and you'll need to ask for it by name". QA's ruling: nothing is
+ * assumed — not a Corrective Action — and the reply is ONE short question, who it is for and which of the forms the app
+ * makes for a policy. Only when the chat has no card and no form request yet, and an earlier turn named a policy. Off,
+ * the answer as given.
+ */
+export const GO_AHEAD_ASK = "Who is it for, and should it be a **Corrective Action** or a **Coaching Form**?";
+
+const NAMES_A_POLICY = /\bpolic(?:y|ies)\b|\bstandards? of conduct\b|\bdress code\b/i;
+
+interface Turn {
+  readonly role: string;
+  readonly content: string;
+  readonly formProposal?: unknown;
+}
+
+function asksForAForm(text: string): boolean {
+  const intent = detectTemplateIntent(text);
+  return intent.kind !== "none" && !(intent.kind === "corrective_action" && !intent.requestedCreation);
+}
+
+export function withGoAheadAsk<T extends { content: string; formProposal?: unknown }>(answer: T, history: readonly Turn[], question: string): T {
+  if (!goAheadAsksWhoAndFormEnabled() || answer.formProposal || !isGoAheadTurn(question)) return answer;
+  if (history.some((turn) => turn.role === "assistant" && turn.formProposal)) return answer;
+  const said = history.filter((turn) => turn.role === "user").map((turn) => String(turn.content ?? ""));
+  if (said.some(asksForAForm) || !said.some((turn) => NAMES_A_POLICY.test(turn))) return answer;
+  return { ...answer, content: GO_AHEAD_ASK };
+}
