@@ -0,0 +1,49 @@
+import { afterEach, describe, expect, it, vi } from "vitest";
+
+import type { AskRequest, AskResponse } from "./types";
+import { withNameCorrectionDate } from "./name-correction-keeps-date";
+
+/* NAME_CORRECTION_KEEPS_DATE_ENABLED (QA, 11 Nov 2026; s14 path 1). The manager's wording; the person is invented. */
+const ASK = "Is this for **Rozlyn Quellmar**? Tell me if that should change.";
+const history = [
+  { id: "u1", role: "user", content: "help me create a coaching form" },
+  { id: "a1", role: "assistant", content: "Here is what I would put on a **Coaching Form**." },
+  { id: "u2", role: "user", content: "October 1st" },
+  { id: "a2", role: "assistant", content: "I still need to know who this is for before I can make this card." },
+  { id: "u3", role: "user", content: "ok, create a follow-up coaching form for rozline quellmar. i trained her on the new promo" },
+  { id: "a3", role: "assistant", content: ASK },
+] as AskRequest["history"];
+const request = (turns = history) => ({ history: turns, context: { todayIso: "2026-11-10" } }) as unknown as Pick<AskRequest, "history" | "context">;
+const card = (employeeName: string | null, formDate: string | null = null) =>
+  ({ content: "Here is what I would put on a **Coaching Form**.", citations: [], formProposal: { templateKey: "coaching", employeeName, formDate } }) as unknown as AskResponse;
+
+describe("NAME_CORRECTION_KEEPS_DATE_ENABLED", () => {
+  afterEach(() => vi.unstubAllEnvs());
+  const on = (value: boolean) => vi.stubEnv("NAME_CORRECTION_KEEPS_DATE_ENABLED", value ? "true" : "");
+
+  it("the answer's card for Rozlyn Quellmar keeps the date given before the question", () => {
+    on(true);
+    expect(withNameCorrectionDate(card("Rozlyn Quellmar"), request()).formProposal?.formDate).toBe("2026-10-01");
+  });
+
+  it("a later card for her (no date of its own) keeps it too", () => {
+    on(true);
+    const later = [...history, { id: "u4", role: "user", content: "Oops, it's Rozlyn quellmar" }, { id: "a4", role: "assistant", content: "Here is what I would put on a **Coaching Form**." }] as AskRequest["history"];
+    expect(withNameCorrectionDate(card("Rozlyn Quellmar"), request(later)).formProposal?.formDate).toBe("2026-10-01");
+  });
+
+  it("a date the card already has is the card's; another person's card is untouched; off, as built", () => {
+    on(true);
+    expect(withNameCorrectionDate(card("Rozlyn Quellmar", "2026-11-03"), request()).formProposal?.formDate).toBe("2026-11-03");
+    expect(withNameCorrectionDate(card("Tess Varga"), request()).formProposal?.formDate ?? null).toBeNull();
+    on(false);
+    const built = card("Rozlyn Quellmar");
+    expect(withNameCorrectionDate(built, request())).toBe(built);
+  });
+
+  it("no name question in the conversation: nothing is filled", () => {
+    on(true);
+    const plain = history.slice(0, 5) as AskRequest["history"];
+    expect(withNameCorrectionDate(card("Rozlyn Quellmar"), request(plain)).formProposal?.formDate ?? null).toBeNull();
+  });
+});
diff --git a/src/lib/ai/name-correction-keeps-date.ts b/src/lib/ai/name-correction-keeps-date.ts
new file mode 100644
index 00000000..4958f49e
--- /dev/null
+++ b/src/lib/ai/name-correction-keeps-date.ts
@@ -0,0 +1,51 @@
+import { nameCorrectionKeepsDateEnabled } from "@/lib/config/chat-quality-flags";
+import { extractFormDate } from "@/lib/forms/form-date-answer";
+
+import type { AskRequest, AskResponse } from "./types";
+
+/**
+ * ============================================================================
+ * A NAME CORRECTION NEVER CLEARS THE CARD'S DATE
+ * ============================================================================
+ *
+ * NAME_CORRECTION_KEEPS_DATE_ENABLED (QA, 11 Nov 2026; Gate-Bubbles' probe of s14 path 1; default off). "help me create a
+ * coaching form" → "October 1st" → "ok, create a follow-up coaching form for rozline quellmar. …" → "Is this for **Rozlyn
+ * Quellmar**?" → "Oops, it's Rozlyn quellmar": the card held 2026-10-01 until the answer, then lost it, on production's
+ * flags too. The answer is read as the request again with the name in full (`first-name-suggest.ts`), a fresh request's
+ * turns start at it, and the card's date is not carried in the conversation's history; every later card for her lost it
+ * too. On: a card for the person whose name the manager corrected in answer to "Is this for …?" / "Did you mean …?" that
+ * has no date of its own takes the date the manager gave before that question (their latest turn that names one, at most
+ * four turns back). Only a missing date is filled; a date the turn gives is the turn's. Off: the response as built.
+ */
+const ASKED = /^(?:Is this for \*\*([^*]+)\*\*\? Tell me if that should change\.|Did you mean (.+?)\? Tell me which, or give the full name\.)/;
+const LOOK_BACK = 4;
+
+type Turn = { readonly role: string; readonly content: unknown };
+
+/** The date the manager gave before the latest name question answered about `employee`, or null. */
+function dateBeforeCorrection(history: readonly Turn[], employee: string, today: string): string | null {
+  const name = employee.trim().toLowerCase();
+  for (let at = history.length - 1; at >= 0; at -= 1) {
+    const turn = history[at]!;
+    if (turn.role !== "assistant") continue;
+    const asked = ASKED.exec(String(turn.content).trim());
+    if (!asked) continue;
+    const options = asked[1] ? [asked[1]] : [...(asked[2] ?? "").matchAll(/\*\*([^*]+)\*\*/g)].map((match) => match[1]!);
+    if (!options.some((option) => option.trim().toLowerCase() === name)) continue;
+    const said = history.slice(0, at).filter((earlier) => earlier.role === "user").slice(-LOOK_BACK).reverse();
+    for (const earlier of said) {
+      const date = extractFormDate(String(earlier.content), today);
+      if (date) return date;
+    }
+    return null;
+  }
+  return null;
+}
+
+export function withNameCorrectionDate(response: AskResponse, request: Pick<AskRequest, "history" | "context">): AskResponse {
+  if (!nameCorrectionKeepsDateEnabled()) return response;
+  const card = response.formProposal;
+  if (!card || card.formDate || !card.employeeName) return response;
+  const formDate = dateBeforeCorrection(request.history ?? [], card.employeeName, request.context.todayIso);
+  return formDate ? { ...response, formProposal: { ...card, formDate } } : response;
+}
